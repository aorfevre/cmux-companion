{
  "name": "cmux-companion",
  "version": "0.1.0",
  "description": "A private, desktop-first cmux control center for your Tailscale network.",
  "private": true,
  "engines": {
    "node": ">=22.23.1 <23"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build && node scripts/stamp-service-worker.mjs",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "companion:dev": "node server/index.mjs",
    "orchestration:dev": "node scripts/run-orchestration-dev.mjs",
    "companion:start": "NODE_ENV=production node server/supervisor.mjs",
    "install:mac": "./scripts/install-macos.sh",
    "uninstall:mac": "./scripts/uninstall-macos.sh",
    "status": "./scripts/status.sh",
    "update:check": "node scripts/updater-operator.mjs check",
    "update:retry": "node scripts/updater-operator.mjs retry",
    "update:disable": "node scripts/updater-operator.mjs disable",
    "update:enable": "node scripts/updater-operator.mjs enable",
    "test": "node scripts/run-backend-tests.mjs",
    "test:coverage": "node --test --test-concurrency=4 --experimental-test-coverage --test-coverage-lines=90 --test-coverage-include='server/**' --test-coverage-include='updater/src/**' --test-coverage-exclude='server/index.mjs' --test-coverage-exclude='server/supervisor.mjs' --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/backend.lcov $(node scripts/run-backend-tests.mjs --list)",
    "test:live": "node --test tests/cmux.live.mjs",
    "test:ui": "NODE_ENV=test vitest run --config vitest.config.ts",
    "test:ui:coverage": "NODE_ENV=test vitest run --config vitest.config.ts --coverage",
    "test:e2e:local": "node scripts/run-local-cypress.mjs",
    "test:e2e:open": "node scripts/run-local-cypress.mjs --open",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.backend.json",
    "verify": "npm run test:coverage && npm run test:ui:coverage && npm run lint && npm run typecheck && npm run build",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "orchestration:faults": "node scripts/run-orchestration-faults.mjs",
    "orchestration:inventory": "node scripts/orchestration-inventory.mjs",
    "test:mac": "node --test --test-concurrency=4 tests/codex-native.test.mjs tests/security.test.mjs tests/api-routes.test.mjs tests/orchestration-native-background.test.mjs tests/orchestration-native-terminal.test.mjs tests/orchestration-ownership.test.mjs tests/orchestration-cleanup.test.mjs"
  },
  "dependencies": {
    "@fastify/http-proxy": "^11.6.1",
    "@fastify/websocket": "^11.3.0",
    "fastify": "^5.12.1",
    "jsonc-parser": "^3.3.1",
    "playwright-core": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.2",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@openai/sites-vite-plugin": "0.1.0",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/cypress": "^10.1.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "^0.5.34",
    "@vitest/coverage-v8": "^4.1.11",
    "cypress": "^16.0.0",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "jsdom": "^30.0.1",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "^1.0.0-beta.8",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.127.1"
  },
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aorfevre/cmux-companion.git"
  }
}
