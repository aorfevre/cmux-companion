CMUX_BIN=/Applications/cmux.app/Contents/Resources/bin/cmux
CMUX_COMPANION_HOST=127.0.0.1
CMUX_COMPANION_PORT=3210
CMUX_COMPANION_FRONTEND_PORT=3211
CMUX_COMPANION_TAILSCALE_PORT=8443
CMUX_COMPANION_TAILSCALE_BIN=/Applications/Tailscale.app/Contents/MacOS/Tailscale
CMUX_COMPANION_VAPID_SUBJECT=https://your-mac.your-tailnet.ts.net:8443
CMUX_COMPANION_CHROME_BIN=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
CMUX_COMPANION_PREVIEW_PORT_START=8500
CMUX_COMPANION_PREVIEW_PORT_END=8599
# Where the repository scan keeps its cache. Deleting this file is safe: the
# next scan is slower and then rebuilds it.
CMUX_COMPANION_REPO_DB=~/.config/cmux-companion/repo-identity.db
# How long a worktree's change count may be reused on the dashboard. Set to 0
# to read git every time. Deleting a worktree always reads it live whatever
# this says.
CMUX_COMPANION_STATUS_TTL_MS=30000
