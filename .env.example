# Optional bootstrap overrides. A fresh installation needs no .env file.
# This file is documentation; companion:dev does not load it automatically.
# Paths must be absolute. Projects, providers, models, tools and execution/preview
# preferences are configured in the paired app and stored locally in SQLite.
# CMUX_COMPANION_DATA_DIR=/absolute/private/cmux-companion
# CMUX_COMPANION_SETTINGS_DB=/absolute/private/cmux-companion/settings.sqlite
# CMUX_COMPANION_TOKEN_FILE=/absolute/private/cmux-companion/token
CMUX_COMPANION_HOST=127.0.0.1
CMUX_COMPANION_PORT=3210
# CMUX_COMPANION_LOG_LEVEL=warn
CMUX_COMPANION_FRONTEND_PORT=3211
# Optional private transport bootstrap; never binds the bridge outside loopback.
CMUX_COMPANION_TAILSCALE_PORT=8443
# Development frontend proxy; set to the disposable backend's printed address.
# CMUX_COMPANION_API=http://127.0.0.1:3210
# Optional updater installation location (source checkout or installed bundle).
# CMUX_COMPANION_UPDATER_REPOSITORY=/absolute/path/to/cmux-companion-updater
